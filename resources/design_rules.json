{
  "spatial_partition": [
    {
      "if": {
        "house_type": "平层",
        "residents_min": 3
      },
      "then": "LDK一体化优先",
      "reason": "增加空间通透感"
    },
    {
      "if": {
        "elderly": true
      },
      "then": "老人房南向+近卫生间",
      "reason": "适老化设计"
    },
    {
      "if": {
        "work_from_home": true
      },
      "then": "独立书房或卧室角落办公区",
      "reason": "减少干扰"
    },
    {
      "if": {
        "pets": "狗"
      },
      "then": "阳台或玄关设置宠物活动区",
      "reason": "宠物友好"
    },
    {
      "if": {
        "cooking_frequency": "热爱烹饪"
      },
      "then": "厨房做封闭式/U型",
      "reason": "油烟控制和操作台面"
    },
    {
      "if": {
        "storage_need": "极强"
      },
      "then": "全屋定制收纳系统",
      "reason": "最大化储物空间"
    }
  ],
  "furniture_layout": {
    "客厅": [
      {
        "furniture": "沙发",
        "rule": "靠最长墙面",
        "distance_to_tv": 3000
      },
      {
        "furniture": "电视柜",
        "rule": "沙发对面墙",
        "width": "墙面宽*0.7"
      },
      {
        "furniture": "茶几",
        "rule": "沙发前方400mm"
      },
      {
        "furniture": "地毯",
        "rule": "茶几下方"
      }
    ],
    "主卧": [
      {
        "furniture": "双人床",
        "rule": "靠北墙/远离门",
        "clearance": "两侧≥600mm"
      },
      {
        "furniture": "衣柜",
        "rule": "靠入口侧墙",
        "clearance": "开门空间≥900mm"
      },
      {
        "furniture": "床头柜",
        "rule": "床两侧各一"
      },
      {
        "furniture": "梳妆台",
        "rule": "靠窗",
        "optional": true
      }
    ],
    "厨房": [
      {
        "furniture": "橱柜",
        "rule": "沿墙U型/L型",
        "counter_depth": 600
      },
      {
        "furniture": "冰箱",
        "rule": "入口附近"
      },
      {
        "furniture": "烟机灶具",
        "rule": "靠外墙/排烟管"
      },
      {
        "furniture": "水槽",
        "rule": "靠窗/黄金三角区"
      }
    ],
    "卫生间": [
      {
        "furniture": "洗手台",
        "rule": "入门侧"
      },
      {
        "furniture": "马桶",
        "rule": "距洗手台≥200mm"
      },
      {
        "furniture": "淋浴房",
        "rule": "角落,最小800x800"
      }
    ],
    "餐厅": [
      {
        "furniture": "餐桌",
        "rule": "居中,距墙≥800mm"
      },
      {
        "furniture": "餐椅",
        "rule": "餐桌四周,每边1-2把"
      }
    ],
    "书房": [
      {
        "furniture": "书桌",
        "rule": "靠窗/靠墙"
      },
      {
        "furniture": "书柜",
        "rule": "靠一面整墙"
      }
    ]
  },
  "lighting_rules": {
    "客厅": [
      {
        "type": "主照明",
        "rule": "无主灯/磁吸轨道/吸顶灯",
        "height": "2800mm以上选无主灯"
      },
      {
        "type": "氛围光",
        "rule": "电视墙灯带+窗帘盒灯带",
        "color_temp": "3000K暖光"
      },
      {
        "type": "重点照明",
        "rule": "沙发旁落地灯/壁画射灯",
        "beam_angle": "24度"
      }
    ],
    "卧室": [
      {
        "type": "主照明",
        "rule": "无主灯/吸顶灯(带调光)"
      },
      {
        "type": "床头",
        "rule": "壁灯/吊灯距地1200mm",
        "color_temp": "2700K"
      },
      {
        "type": "衣柜",
        "rule": "柜内感应灯带"
      }
    ],
    "厨房": [
      {
        "type": "基础照明",
        "rule": "4000K筒灯均匀分布",
        "spacing": "距墙600mm"
      },
      {
        "type": "操作台",
        "rule": "吊柜下灯带",
        "brightness": ">300lux"
      }
    ],
    "卫生间": [
      {
        "type": "镜前灯",
        "rule": "左右两侧/上方",
        "color_temp": "4000K"
      },
      {
        "type": "淋浴区",
        "rule": "防水筒灯IP65"
      }
    ]
  },
  "storage_rules": {
    "玄关": {
      "type": "鞋柜",
      "depth": 350,
      "capacity": "每人8-12双",
      "features": [
        "底部悬空150mm放常用鞋",
        "中间镂空放钥匙"
      ]
    },
    "客厅": {
      "type": "电视柜/边柜",
      "rule": "整墙收纳柜深度350-400mm"
    },
    "厨房": {
      "type": "地柜+吊柜+高柜",
      "depth": "地柜600/吊柜350",
      "features": [
        "转角拉篮",
        "下拉拉篮",
        "抽屉>平开门"
      ]
    },
    "卧室": {
      "type": "衣柜",
      "depth": 600,
      "rule": "挂区>叠区",
      "内部": "挂衣杆距地1900mm"
    },
    "卫生间": {
      "type": "镜柜+浴室柜",
      "rule": "镜柜深度120mm",
      "features": [
        "侧面开放格",
        "插座内嵌"
      ]
    },
    "阳台": {
      "type": "家政柜",
      "rule": "洗衣机+烘干机+清洁工具",
      "size": "宽1200x深650"
    }
  },
  "traffic_flow": {
    "主要通道": ">=1000mm",
    "次要通道": ">=800mm",
    "厨房操作": ">=1000mm",
    "床尾通道": ">=600mm",
    "沙发到茶几": "300-400mm",
    "餐桌到墙": ">=800mm",
    "马桶前方": ">=600mm",
    "淋浴房": ">=800x800mm"
  },
